 HostServiceStatus HostServices::set_cursor(CursorKind cursor) {
     HostServiceStatus status = validate_request(HostCapability::cursor);
-    if (!status.accepted() || snapshot_.cursor == cursor) {
+    if (!status.accepted()) {
