+#define BidiLinkNone    (SBUInt32)(-1)
+
+enum {
+    BidiFlagNone   = 0x00,
+    BidiFlagSingle = 0x01
+};
+typedef SBUInt8 BidiFlag;
+
+typedef struct _BidiChain {
+    SBBidiType *types;
+    SBLevel *levels;
+    BidiFlag *flags;
