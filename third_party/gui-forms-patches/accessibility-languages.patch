+        return PrimaryGeneralCategoryData[
+                MainGeneralCategoryIndexes[
+                 BranchGeneralCategoryIndexes[
+                      codepoint / 0x0400
+                 ] + (codepoint % 0x0400) / 0x0010
+                ] + (codepoint % 0x0010)
+               ];
+    }
+
+    return Cn;
+}
