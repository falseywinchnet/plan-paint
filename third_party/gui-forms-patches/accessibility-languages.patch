+            if (parent) {
+                for (std::size_t i = 0; i < (*parent).children.size(); ++i) {
+                    if ((*parent).children[i].runtime_id != (*found).runtime_id) { continue; }
+                    if (direction == NAVDIR_NEXT && i + 1 < (*parent).children.size()) { target = &(*parent).children[i + 1]; }
