+{
+    if (locator) {
+        locator->retainCount += 1;
+    }
+
+    return locator;
+}
+
+void SBScriptLocatorRelease(SBScriptLocatorRef locator)
+{
+    if (locator && --locator->retainCount == 0) {
+        ObjectDispose(&locator->_object);
+    }
+}
